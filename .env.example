# Database Configuration
# Default (SQLite local file demo):
DATABASE_URL=sqlite:///student_progression.db

# For PostgreSQL deployment, uncomment and update credentials:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/student_progression

# Flask Security & Environment
SECRET_KEY=academic-progression-mini-project-secret-2026
FLASK_DEBUG=0

# Google Sheets One-Way Synchronization Options:
# Option 1: Google Apps Script Webhook URL (Easiest, zero Google Cloud setup required):
GOOGLE_SHEET_WEBHOOK_URL=

# Option 2: Google Cloud Service Account (gspread):
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
